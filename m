>>   		goto nla_put_failure;
>>   	if (nla_put_be32(skb, NFTA_EXTHDR_OP, htonl(priv->op)))
>>   		goto nla_put_failure;
>> +	if (priv->has_inner) {
>> +		if (nla_put_be32(skb, NFTA_EXTHDR_INNER_TYPE,  htonl(priv->inner_type)))
> 
