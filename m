-	{
-		if ( portptr[0] <= port && port <= portptr[1] )
-		{
-			return( 1 );
-		}
-		nports -= 2;
-		portptr += 2;
-	}
-	while ( nports-- > 0 )
-	{
-		if ( *portptr++ == port )
-		{
-			return( 1 );
-		}
-	}
