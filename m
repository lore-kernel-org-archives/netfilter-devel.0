-		{
-			was_found=1;
-			if (ftmp->fw_viadev
-			    && ftmp->fw_viadev != (struct net_device *)-1)
-				dev_put(ftmp->fw_viadev);
-			if (ltmp)
-			{
-				ltmp->fw_next=ftmp->fw_next;
-				kfree(ftmp);
-				ftmp=ltmp->fw_next;
-        		}
-      			else
