Tuned the file '.gitignore' and 'src/.gitignore' to filter out the auto
generated files.
---
 .gitignore     | 19 ++++++++++++-------
 src/.gitignore |  4 ++--
 2 files changed, 14 insertions(+), 9 deletions(-)

diff --git a/.gitignore b/.gitignore
index d26b395..998760d 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,18 +1,23 @@
-# Dependency and object files
-.*.d
-*.o
-
 # Generated by autoconf/configure
 Makefile
-Makefile.defs
-Makefile.rules
+Makefile.in
 config.h
 config.h.in
-config.h.in~
 config.log
 config.status
 configure
 autom4te.cache
+missing
+compile
+depcomp
+stamp-h1
+ylwrap
+aclocal.m4
+install-sh
+.deps
+*.o
+*~
+
 
 # Debian package build temporary files
 build-stamp
diff --git a/src/.gitignore b/src/.gitignore
index 23e6ae0..50ff292 100644
--- a/src/.gitignore
+++ b/src/.gitignore
@@ -1,5 +1,5 @@
-parser.c
-parser.h
+yacc_parser.c
+yacc_parser.h
 scanner.c
 scanner.h
 nft
