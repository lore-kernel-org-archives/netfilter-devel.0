-		/* If it is a truncated first fragment then it can be
-		 * used to rewrite port information, and thus should
-		 * be blocked.
-		 */
-		if (ntohs((*pskb)->nh.iph->tot_len) <
-		    ((*pskb)->nh.iph->ihl<<2)+size_req) {
