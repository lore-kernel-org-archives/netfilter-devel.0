-static void zero_fw_chain(struct ip_fw *chainptr)
-{
-	struct ip_fw *ctmp=chainptr;
-	
-	WRITE_LOCK(&ip_fw_lock);
-	while(ctmp)
-	{
-		ctmp->fw_pcnt=0L;
-		ctmp->fw_bcnt=0L;
-		ctmp=ctmp->fw_next;
-	}
-	WRITE_UNLOCK(&ip_fw_lock);
-}
