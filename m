-		case IPPROTO_UDP:
-			dprintf("UDP ");
-			if (!offset) {
-				struct udphdr _udph, *uh;
-
-				uh = skb_header_pointer(*pskb,
-							(*pskb)->nh.iph->ihl*4,
-							sizeof(_udph), &_udph);
-				if (uh == NULL)
-					return FW_BLOCK;
-
-				src_port = ntohs(uh->source);
-				dst_port = ntohs(uh->dest);
-			}
