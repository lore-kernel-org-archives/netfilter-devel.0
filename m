-			dprintf("TCP ");
-			if (!offset) {
-				struct tcphdr _tcph, *th;
-
-				th = skb_header_pointer(*pskb,
-							(*pskb)->nh.iph->ihl*4,
-							sizeof(_tcph), &_tcph);
