Hello.

The following warning is reproducible with the code below on 2.6.25.6,
which uses sendmsg on a udp socket using two iovecs:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <netdb.h>

/* only triggers when > (1<<13) */
#define SIZE (1<<14)

int main(int argc, char **argv)
{
	int sockfd;
	struct sockaddr_in host_address;
	struct hostent *ptrh;
	struct iovec iovec_arr[2];
	struct msghdr msg;
	char arr[SIZE*2];

	
	if (argc != 3) {
		printf("Usage: %s dst_host dst_port\n", argv[0]);
		exit(10);
	}

	sockfd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
	if (sockfd <= 0) {
		printf("error creating socket: %m\n");
		exit(10);
	}

	ptrh = gethostbyname(argv[1]);
	if ( ((char *)ptrh) == NULL ) {
		fprintf(stderr,"invalid host: %s\n",argv[1]);
		exit(1);
	}
	memset(&host_address, 0, sizeof(host_address));
	memcpy(&host_address.sin_addr, ptrh->h_addr, ptrh->h_length);
	host_address.sin_port = htons(atoi(argv[2]));

	memset(arr, 0, sizeof(arr));

	bzero(&msg, sizeof(msg));
	msg.msg_name = &host_address;
	msg.msg_namelen = sizeof(host_address);
	iovec_arr[0].iov_base = arr;
	iovec_arr[0].iov_len = SIZE;
	iovec_arr[1].iov_base = arr+SIZE;
	/* triggers when the next size is > 25 */
	iovec_arr[1].iov_len = 25;
	/* only triggers when this is 2 !! */
	msg.msg_iovlen = 2;
	msg.msg_iov = iovec_arr;

	if (sendmsg(sockfd, &msg, 0) == -1){
		printf("error sending packet: %m\n");
		printf("a total of %d\n", msg.msg_iov[0].iov_len +
				msg.msg_iov[1].iov_len);
	}
	return 0;
}


