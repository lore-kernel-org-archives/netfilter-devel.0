+		perror("mnl_ring_build_frame");
+		exit(EXIT_FAILURE);
+	}
+
+	if (mnl_ring_send(nlm) < 0) {
+		perror("mnl_ring_send");
+		exit(EXIT_FAILURE);
+	}
