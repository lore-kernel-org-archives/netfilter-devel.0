+		exthdr.c			\
+		meta.c				\
+		ct.c				\
+		netlink.c			\
+		netlink_linearize.c		\
+		netlink_delinearize.c		\
+		segtree.c			\
+		rbtree.c			\
+		gmputil.c			\
+		utils.c				\
+		erec.c				\
+		mnl.c				\
+		scanner.l			\
+		parser_bison.y
+
+if BUILD_CLI
+nft_SOURCES +=	cli.c
+endif
+
+nft_LDADD	= ${LIBMNL_LIBS} ${LIBNFTNL_LIBS}
