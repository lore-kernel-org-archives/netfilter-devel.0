-
-	if (!testing) FWC_READ_LOCK(&ip_fw_lock);
-	else FWC_HAVE_LOCK(fwc_rlocks);
-
-	f = chain->chain;
-	do {
-		count = 0;
-		for (; f; f = f->next) {
-			count++;
-			if (ip_rule_match(f, rif, pskb,
-					  tcpsyn, src_port, dst_port,
-					  offset)) {
-				if (!testing
